# vscode
.vscode/
.vscode/*

# Things to ignore from preprocess
# We first ignore everything
preprocess/*

# But we want to keep these
!preprocess/environment.yml
!preprocess/requirements.in
!preprocess/requirements-lock.txt
!preprocess/main.py
!preprocess/multispeaker_remover.py
!preprocess/pyannote_diarize.py
!preprocess/README.md

# Things to ignore from models/xtts-finetune-cli
# We first ignore everything
models/xtts-finetune-cli/*
models/xtts-finetune-cli/utils/__pycache__/

# But we want to keep these
!models/xtts-finetune-cli/main.py
!models/xtts-finetune-cli/README.md
!models/xtts-finetune-cli/environment.yml
!models/xtts-finetune-cli/requirements.in
!models/xtts-finetune-cli/requirements-lock.txt
!models/xtts-finetune-cli/utils/
!models/xtts-finetune-cli/utils/__init__.py
!models/xtts-finetune-cli/utils/formatter.py
!models/xtts-finetune-cli/utils/gpt_train.py
!models/xtts-finetune-cli/utils/tokenizer.py
!models/xtts-finetune-cli/utils/xtts_header.py

# Things to ignore from models/yourtts
# We fist ignore everything
models/yourtts/*

# But we want to keep these
!models/yourtts/main.py
!models/yourtts/README.md
!models/yourtts/environment.yml
!models/yourtts/requirements.in
!models/yourtts/requirements-lock.txt

# Things to ignore from scores/wespeaker
# We first ignore everything
scores/wespeaker/*

# But we want to keep these
!scores/wespeaker/compare.py
!scores/wespeaker/environment.yml
!scores/wespeaker/requirements.in
!scores/wespeaker/requirements-lock.txt
!scores/wespeaker/pipe.sh
!scores/wespeaker/README.md
!scores/wespeaker/gpu/
!scores/wespeaker/gpu/compute.py
!scores/wespeaker/gpu/pipe.sh
!scores/wespeaker/gpu/README.md